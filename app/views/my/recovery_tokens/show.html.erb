<% content_for :title, "Recovery token" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="max-w-md mx-auto px-4 py-8 font-sans">
  <div class="bg-white border-[3px] border-zinc-900 shadow-[8px_8px_0px_0px_rgba(20,20,23,0.8)] p-8 space-y-6">
    <h1 class="text-2xl font-black uppercase tracking-tight">Save your recovery token</h1>
    <p class="text-sm text-zinc-600">Keep it in your password manager. Anyone with this token can act as you, including with your facilitator or administrator permissions. Do not share it in a retro or invite.</p>

    <% if @recovery_token %>
      <label for="recovery_token" class="block text-xs font-bold uppercase tracking-widest">Recovery token (shown once)</label>
      <input id="recovery_token" type="text" value="<%= @recovery_token %>" readonly autocomplete="off" spellcheck="false" class="w-full px-3 py-3 border-[2px] border-zinc-900 font-mono text-xs">
      <p class="text-sm text-zinc-600">The server stores only a digest. Once you leave this page, this token cannot be displayed again.</p>
    <% else %>
      <p class="text-sm text-zinc-600">Tokens are shown only once. If you did not save yours, generate a replacement while you still have access.</p>
    <% end %>

    <%= link_to "Continue", @continue_url, class: "block px-6 py-3 bg-zinc-900 text-white text-center font-bold uppercase", data: { turbo: false } %>
    <%= button_to "Generate replacement token", my_recovery_token_path(script_name: nil), data: { turbo: false }, class: "text-sm underline" %>
    <p class="text-xs text-zinc-600">A replacement invalidates the previous token and signs out your other browser sessions.</p>
  </div>
</div>
