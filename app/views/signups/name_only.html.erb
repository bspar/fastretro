<% content_for :title, "Create a team" %>

<div class="max-w-md mx-auto px-4 py-8 font-sans">
  <div class="bg-white border-[3px] border-zinc-900 shadow-[8px_8px_0px_0px_rgba(20,20,23,0.8)] p-8 space-y-6">
    <h1 class="text-2xl font-black uppercase tracking-tight">Create a team</h1>
    <p class="text-sm text-zinc-600">Just your name. No email, password, or verification code needed.</p>

    <% if @signup.errors.any? %>
      <p role="alert" class="text-sm text-red-600"><%= @signup.errors.full_messages.to_sentence %></p>
    <% end %>

    <%= form_with model: @signup, url: signup_path, scope: :signup, data: { turbo: false }, class: "space-y-6" do |form| %>
      <div>
        <%= form.label :full_name, "Your name", class: "block text-xs font-bold uppercase tracking-widest mb-2" %>
        <%= form.text_field :full_name, required: true, maxlength: 100, autofocus: true, autocomplete: "name", class: "w-full px-4 py-3 border-[2px] border-zinc-900 bg-white" %>
      </div>
      <%= form.submit "Create team", class: "w-full px-6 py-3 bg-zinc-900 text-white font-bold uppercase cursor-pointer" %>
    <% end %>

    <p class="text-sm text-zinc-600">Joining someone else's retro? Use their invite link instead.</p>
    <%= link_to "Already have a recovery token?", new_session_path, class: "block text-sm underline" %>
  </div>
</div>
