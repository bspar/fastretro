# Copy to .env, chmod 600 .env, and generate a fresh SECRET_KEY_BASE.
# APP_HOST must match the address and port used by your browser.
FASTRETRO_BIND_ADDRESS=127.0.0.1
FASTRETRO_PORT=8080
APP_HOST=localhost:8080
MAILER_FROM_ADDRESS=fastretro@localhost
SECRET_KEY_BASE=
# Optional trusted-network login without email; defaults to disabled.
NAME_ONLY_AUTH=false
